{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/rot-session-start.sh",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/rot-before-prompt.sh",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/rot-after-response.sh",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/rot-after-tool.sh",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/deny-shell.js",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/deny-read.js",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/stop-check.sh",
        "timeout": 120,
        "loop_limit": 2
      },
      {
        "command": ".cursor/hooks/rot-pulse.sh",
        "timeout": 20,
        "loop_limit": 1
      }
    ]
  }
}
